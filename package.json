{
  "name": "pakulab",
  "version": "0.1.0",
  "private": true,
  "description": "Pakulab - Complementary Food App MVP",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter @pakulab/shared build && pnpm --filter api build && pnpm --filter web build",
    "typecheck": "pnpm --filter @pakulab/shared typecheck && pnpm --filter api typecheck && pnpm --filter web typecheck",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:push": "pnpm --filter api db:push",
    "db:migrate-free": "npx tsx prisma/scripts/migrate-free-to-expired.ts",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=Mobile",
    "test:e2e:desktop": "playwright test --project=Desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}