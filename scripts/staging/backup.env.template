# ── Staging SSH + DB backup config ─────────────────────────────────────────
# Copy this file to `.env` in THIS folder and fill in the real values:
#
#   cp scripts/staging/backup.env.template scripts/staging/.env
#   # then edit scripts/staging/.env with your real values
#
# The `.env` file is gitignored — secrets and DB dumps never reach the repo.
# ────────────────────────────────────────────────────────────────────────────

# ── SSH connection to the VPS ───────────────────────────────────────────────
# Host/IP of the VPS running staging (e.g. 203.0.113.10 or vps.example.com)
SSH_HOST=REPLACE_WITH_VPS_HOST

# SSH user (e.g. root, deploy, ubuntu)
SSH_USER=REPLACE_WITH_SSH_USER

# SSH port (usually 22)
SSH_PORT=22

# Absolute path to your private key for this VPS (e.g. /Users/you/.ssh/id_ed25519).
# Leave empty to use your default SSH agent / ~/.ssh/config.
SSH_KEY=

# ── Postgres container + credentials on the VPS ──────────────────────────────
# Name of the running staging Postgres container. Find it on the VPS with:
#   docker ps --format '{{.Names}}' | grep -i db
# From docker-compose.staging.yml the service is `db`; Dokploy usually prefixes
# it (e.g. pakulab-staging-db-1). Set the ACTUAL name.
DB_CONTAINER=REPLACE_WITH_DB_CONTAINER_NAME

# Database name (docker-compose.staging.yml → pakulab_staging)
DB_NAME=pakulab_staging

# Database user (docker-compose.staging.yml → pakulab)
DB_USER=pakulab
