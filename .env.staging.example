# ══════════════════════════════════════════════════════════════════════════════
# Pakulab Staging — Environment Variables
# Copy these into Dokploy > Compose > Environment Variables
# ══════════════════════════════════════════════════════════════════════════════

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Used by the db-init and api services. Pick a strong password.
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# ── AUTH (BetterAuth) ─────────────────────────────────────────────────────────
# Secret for signing session tokens. MUST be at least 32 characters.
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32

# ── STRIPE (use TEST keys for staging) ────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# These are used by the API AND injected as VITE_* build args for the frontend.
# The web Dockerfile maps STRIPE_PRICE_MONTHLY → VITE_STRIPE_PRICE_MONTHLY
# and STRIPE_PRICE_YEARLY → VITE_STRIPE_PRICE_ANNUAL at build time.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── GOOGLE OAUTH (optional — leave empty to disable) ─────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add https://staging.pakulab.cloud as authorized origin
# Add https://staging.pakulab.cloud/api/auth/callback/google as redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
